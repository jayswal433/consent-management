# =============================================================================
# ENVIRONMENT CONFIGURATION — EXAMPLE FILE
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_HOST=localhost
SERVER_PORT=9000
BASE_URL=http://localhost:9000

# Environment: local | development | staging | production
ENV=local
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Driver: sqlite+aiosqlite | mysql+aiomysql
DB_DRIVER=mysql+aiomysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=consent_management

# SQLite alternative (used when DB_DRIVER=sqlite+aiosqlite)
DB_URL=sqlite+aiosqlite:///./consent_management.db

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT — generate a strong random secret for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Format: text | json
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=logs/app.log

# =============================================================================
# EMAIL / SMTP CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Consent Management

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,csv
UPLOAD_PATH=uploads/
STATIC_FILES_PATH=static/

# =============================================================================
# AWS / S3 CONFIGURATION
# =============================================================================
S3_UPLOAD_ENABLED=false
AWS_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_EXPIRE_TIME=3600
REGION=ap-south-1
PRIVATE_BUCKET=your-private-bucket-name
PUBLIC_BUCKET=your-public-bucket-name
AWS_BASE_URL=https://your-public-bucket.s3.ap-south-1.amazonaws.com/
PROXY_BASE_URL=https://your-domain.example.com/
SUPPORT_LAMBDA_FUNCTION=False

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=false

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
WORKER_PROCESSES=1
WORKER_CONNECTIONS=100
KEEPALIVE_TIMEOUT=5
MAX_REQUESTS_PER_WORKER=0
PRELOAD_APP=false

# =============================================================================
# SECURITY HEADERS
# =============================================================================
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
